{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cdss.local/schema/kb-extract-0.1.json",
  "title": "文献全文抽取输出（每篇文献一份）",
  "description": "LLM 只输出本结构；所有 *_ref 为本文件内的局部引用，入库时由程序转换为数据库 ID 并校验引用完整性。数值一律保留 value_as_reported 原样字符串；未报告填 null，不得推算或补全。概念只给原文用词和类型，concept_code 仅在提示词提供的术语表中有完全对应项时填写，映射由程序和审核完成。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_version_id",
    "evidence_spans",
    "document",
    "studies",
    "populations",
    "arms",
    "outcomes",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "kb-extract-0.1"
    },
    "document_version_id": {
      "type": "string",
      "description": "解析层提供的文献版本 ID，原样回填"
    },
    "evidence_spans": {
      "type": "array",
      "description": "本次输出引用到的全部原文片段。quote 必须逐字摘自 block_id 对应的解析块，程序会校验。",
      "items": {
        "$ref": "#/$defs/Span"
      }
    },
    "document": {
      "$ref": "#/$defs/DocumentTriage"
    },
    "studies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Study"
      }
    },
    "populations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Population"
      }
    },
    "arms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Arm"
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Outcome"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Finding"
      }
    },
    "meta_analysis": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/MetaAnalysis"
        }
      ]
    },
    "recommendations": {
      "type": "array",
      "description": "仅 doc_kind 为 guideline / consensus_or_position 时填写；作为人工整理的预填，不直接发布。",
      "items": {
        "$ref": "#/$defs/Recommendation"
      }
    },
    "guideline_info": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/GuidelineInfo"
        }
      ],
      "description": "指南/共识的基本信息；其他文献为 null"
    },
    "definitions": {
      "type": "array",
      "description": "文中对术语给出的操作性定义（方法段或指南定义条款；背景段的转述不填）。",
      "items": {
        "$ref": "#/$defs/TermDefinition"
      }
    },
    "assertions": {
      "type": "array",
      "description": "无法表达为 Finding 的实体间关系，主要用于基础研究、综述；进入研究区，不进临床层。",
      "items": {
        "$ref": "#/$defs/Assertion"
      }
    },
    "schema_extension_candidates": {
      "type": "array",
      "description": "重要但当前结构无法表达的内容，交审核扩展 schema；不得自行发明字段。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "span_ids"
        ],
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "span_ids": {
            "$ref": "#/$defs/SpanIdList"
          }
        }
      }
    }
  },
  "$defs": {
    "Ref": {
      "type": "string",
      "pattern": "^[A-Z]{1,3}[0-9]{1,4}$",
      "description": "局部引用 ID，如 ST1、P1、A1、O1、F1、S1、R1"
    },
    "SpanId": {
      "type": "string",
      "pattern": "^S[0-9]{1,4}$"
    },
    "SpanIdList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SpanId"
      },
      "uniqueItems": true
    },
    "NullableNumber": {
      "type": [
        "number",
        "null"
      ]
    },
    "NullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "Span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "span_id",
        "block_id",
        "quote"
      ],
      "properties": {
        "span_id": {
          "$ref": "#/$defs/SpanId"
        },
        "block_id": {
          "type": "string",
          "description": "解析层块 ID（段落、表格单元格、图注）"
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    },
    "ConceptRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "concept_type"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "原文用词"
        },
        "concept_type": {
          "enum": [
            "disease_or_lesion",
            "histology",
            "morphology",
            "anatomic_site",
            "procedure",
            "drug",
            "exposure_factor",
            "test_or_index",
            "biomarker",
            "outcome_event",
            "quality_metric",
            "symptom_or_sign",
            "population_trait",
            "genetic_syndrome",
            "organism",
            "gene_or_pathway",
            "other"
          ]
        },
        "concept_code": {
          "$ref": "#/$defs/NullableString"
        }
      }
    },
    "Quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "as_reported"
      ],
      "properties": {
        "op": {
          "enum": [
            "eq",
            "lt",
            "le",
            "gt",
            "ge",
            "range",
            "approx"
          ]
        },
        "value": {
          "$ref": "#/$defs/NullableNumber"
        },
        "value_low": {
          "$ref": "#/$defs/NullableNumber"
        },
        "value_high": {
          "$ref": "#/$defs/NullableNumber"
        },
        "low_inclusive": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "high_inclusive": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "unit": {
          "$ref": "#/$defs/NullableString"
        },
        "as_reported": {
          "type": "string"
        }
      }
    },
    "Condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept",
        "qualifier",
        "span_ids"
      ],
      "properties": {
        "concept": {
          "$ref": "#/$defs/ConceptRef"
        },
        "qualifier": {
          "enum": [
            "present",
            "absent",
            "measured"
          ]
        },
        "quantity": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Quantity"
            }
          ]
        },
        "rule_field_code": {
          "$ref": "#/$defs/NullableString",
          "description": "可映射到患者级 rule_input 字段时填写（提示词提供字段表）"
        },
        "or_group": {
          "type": [
            "integer",
            "null"
          ],
          "description": "同组条件为“或”关系；不同组之间为“且”"
        },
        "span_ids": {
          "$ref": "#/$defs/SpanIdList"
        }
      }
    },
    "DocumentTriage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_kind",
        "subject_scope",
        "triage_uncertainty"
      ],
      "properties": {
        "doc_kind": {
          "enum": [
            "guideline",
            "consensus_or_position",
            "original_research",
            "systematic_review_or_ma",
            "narrative_review",
            "case_report_or_series",
            "methodology_or_technical",
            "other"
          ]
        },
        "subject_scope": {
          "enum": [
            "human",
            "animal",
            "in_vitro",
            "in_silico",
            "mixed",
            "not_applicable"
          ]
        },
        "triage_uncertainty": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "triage_note": {
          "$ref": "#/$defs/NullableString"
        }
      }
    },
    "Study": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_ref",
        "design_coarse",
        "design_uncertainty",
        "unit_of_analysis_default"
      ],
      "properties": {
        "study_ref": {
          "$ref": "#/$defs/Ref"
        },
        "design_coarse": {
          "enum": [
            "rct",
            "nonrandomized_trial",
            "cohort",
            "case_control",
            "cross_sectional",
            "diagnostic_accuracy",
            "sr_ma",
            "case_series",
            "case_report",
            "other"
          ]
        },
        "design_as_reported": {
          "$ref": "#/$defs/NullableString"
        },
        "design_uncertainty": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "registration_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parent_study_name": {
          "$ref": "#/$defs/NullableString",
          "description": "母研究/母队列名称，如 PLCO、National Polyp Study"
        },
        "countries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "n_centers": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "period_as_reported": {
          "$ref": "#/$defs/NullableString"
        },
        "terminology_version": {
          "$ref": "#/$defs/NullableString",
          "description": "病理/内镜分类所依据的标准及版本原文，如 WHO 2019、WHO 2010；未写明为 null"
        },
        "data_source": {
          "enum": [
            "prospective_collection",
            "retrospective_records",
            "registry_or_database",
            "trial_secondary_analysis",
            "mixed",
            "not_reported"
          ]
        },
        "unit_of_analysis_default": {
          "$ref": "#/$defs/UnitOfAnalysis"
        },
        "span_ids": {
          "$ref": "#/$defs/SpanIdList"
        }
      }
    },
    "UnitOfAnalysis": {
      "enum": [
        "patient",
        "lesion",
        "colonoscopy",
        "specimen",
        "image",
        "study",
        "other",
        "not_reported"
      ]
    },
    "Population": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population_ref",
        "study_ref",
        "role",
        "label",
        "age",
        "indication_setting",
        "span_ids"
      ],
      "properties": {
        "population_ref": {
          "$ref": "#/$defs/Ref"
        },
        "study_ref": {
          "$ref": "#/$defs/Ref"
        },
        "parent_population_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Ref"
            }
          ]
        },
        "role": {
          "enum": [
            "overall",
            "arm",
            "subgroup",
            "case_group",
            "control_group",
            "analysis_set",
            "guideline_scope"
          ]
        },
        "label": {
          "type": "string"
        },
        "age": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "description": "只填纳入标准或推荐适用范围中的年龄界限；样本均值/中位数不填（只留 span）",
          "properties": {
            "state": {
              "enum": [
                "specified",
                "partially_specified",
                "not_reported"
              ]
            },
            "lower": {
              "$ref": "#/$defs/NullableNumber"
            },
            "lower_inclusive": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "upper": {
              "$ref": "#/$defs/NullableNumber"
            },
            "upper_inclusive": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "unit": {
              "enum": [
                "year",
                "month",
                null
              ]
            },
            "basis": {
              "enum": [
                "eligibility_criterion",
                "recommendation_scope",
                null
              ]
            }
          }
        },
        "pediatric_included": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "indication_setting": {
          "enum": [
            "screening",
            "fit_or_fobt_positive",
            "surveillance",
            "symptomatic",
            "inpatient",
            "mixed",
            "not_applicable",
            "not_reported"
          ]
        },
        "eligibility_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "description": "病变/患者层面的纳入条件，如息肉大小 4–9 mm"
        },
        "exclusion_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Condition"
          }
        },
        "risk_background": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConceptRef"
          },
          "description": "既往腺瘤、家族史、IBD、糖尿病等人群特征"
        },
        "n": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "unit"
              ],
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 0
                },
                "unit": {
                  "$ref": "#/$defs/UnitOfAnalysis"
                }
              }
            }
          ]
        },
        "span_ids": {
          "$ref": "#/$defs/SpanIdList"
        },
        "subgroup_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "description": "role=subgroup 时必填：定义该亚组的条件（相对 parent_population 增加的限定），如 BMI≥30、息肉 5–7 mm、服用阿司匹林"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "subgroup"
              }
            }
          },
          "then": {
            "required": [
              "subgroup_conditions"
            ],
            "properties": {
              "subgroup_conditions": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "Arm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm_ref",
        "study_ref",
        "label",
        "role",
        "interventions"
      ],
      "properties": {
        "arm_ref": {
          "$ref": "#/$defs/Ref"
        },
        "study_ref": {
          "$ref": "#/$defs/Ref"
        },
        "population_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Ref"
            }
          ]
        },
        "label": {
          "type": "string"
        },
        "role": {
          "enum": [
            "intervention",
            "control",
            "placebo",
            "exposure_level",
            "reference_level",
            "index_test",
            "reference_standard"
          ]
        },
        "interventions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "concept",
              "details_as_reported"
            ],
            "properties": {
              "concept": {
                "$ref": "#/$defs/ConceptRef"
              },
              "dose": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/Quantity"
                  }
                ]
              },
              "frequency_as_reported": {
                "$ref": "#/$defs/NullableString"
              },
              "route": {
                "$ref": "#/$defs/NullableString"
              },
              "duration": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/Quantity"
                  }
                ]
              },
              "details_as_reported": {
                "type": "string"
              },
              "span_ids": {
                "$ref": "#/$defs/SpanIdList"
              }
            }
          }
        }
      }
    },
    "Outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_ref",
        "concept",
        "label_as_reported",
        "timepoint",
        "primacy"
      ],
      "properties": {
        "outcome_ref": {
          "$ref": "#/$defs/Ref"
        },
        "concept": {
          "$ref": "#/$defs/ConceptRef"
        },
        "label_as_reported": {
          "type": "string"
        },
        "definition_span_ids": {
          "$ref": "#/$defs/SpanIdList"
        },
        "definition_variant_id": {
          "$ref": "#/$defs/NullableString",
          "description": "从提示词提供的定义变体字典中选择；无对应填 unmatched；文中未定义填 null"
        },
        "ascertainment": {
          "enum": [
            "colonoscopy",
            "sigmoidoscopy",
            "pathology",
            "imaging",
            "registry",
            "self_report",
            "laboratory",
            "clinical_assessment",
            "other",
            "not_reported"
          ]
        },
        "timepoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "enum": [
                "specified",
                "not_reported",
                "not_applicable"
              ]
            },
            "quantity": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/Quantity"
                }
              ]
            },
            "anchor": {
              "enum": [
                "index_colonoscopy",
                "randomization",
                "resection",
                "diagnosis",
                "enrollment",
                "other",
                null
              ]
            }
          }
        },
        "primacy": {
          "enum": [
            "primary",
            "secondary",
            "not_stated"
          ]
        },
        "outcome_scope": {
          "enum": [
            "local_recurrence",
            "metachronous",
            "mixed",
            "not_applicable",
            "unclear"
          ],
          "description": "复发/新发类结局的范围：local_recurrence 原切除部位复发；metachronous 其他部位新发（异时性）；mixed 原文定义同时包含两者；不属于此类结局填 not_applicable；原文未说明填 unclear"
        }
      }
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measure",
        "value_as_reported"
      ],
      "properties": {
        "measure": {
          "enum": [
            "count",
            "n_over_N",
            "proportion",
            "rate",
            "incidence_rate",
            "mean",
            "median",
            "sd",
            "se",
            "iqr",
            "range",
            "rr",
            "or",
            "hr",
            "rd",
            "md",
            "smd",
            "nnt",
            "tp",
            "fp",
            "fn",
            "tn",
            "sensitivity",
            "specificity",
            "ppv",
            "npv",
            "auc",
            "accuracy",
            "kappa",
            "lr_pos",
            "lr_neg",
            "dor",
            "i_squared",
            "correlation",
            "other"
          ]
        },
        "arm_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Ref"
            }
          ]
        },
        "value_as_reported": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "$ref": "#/$defs/NullableNumber"
        },
        "ci_low": {
          "$ref": "#/$defs/NullableNumber"
        },
        "ci_high": {
          "$ref": "#/$defs/NullableNumber"
        },
        "ci_level": {
          "$ref": "#/$defs/NullableNumber"
        },
        "numerator": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "denominator": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "unit": {
          "$ref": "#/$defs/NullableString"
        },
        "p_as_reported": {
          "$ref": "#/$defs/NullableString"
        },
        "category": {
          "type": [
            "string",
            "null"
          ],
          "description": "同一变量的不同类别/水平/时点时，该数值对应的类别（原文用词），如“腹痛”“近端结肠”“≥30 pills/month”“3年”"
        }
      }
    },
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_ref",
        "study_ref",
        "statement_role",
        "finding_type",
        "population_ref",
        "unit_of_analysis",
        "results",
        "source_span_ids"
      ],
      "properties": {
        "finding_ref": {
          "$ref": "#/$defs/Ref"
        },
        "study_ref": {
          "$ref": "#/$defs/Ref"
        },
        "statement_role": {
          "enum": [
            "own_result",
            "cited_result",
            "author_conclusion",
            "recommendation",
            "other"
          ]
        },
        "finding_type": {
          "enum": [
            "comparative_effect",
            "association",
            "descriptive_frequency",
            "descriptive_continuous",
            "diagnostic_accuracy",
            "pooled_estimate",
            "time_to_event",
            "correlation",
            "case_observation",
            "other"
          ]
        },
        "population_ref": {
          "$ref": "#/$defs/Ref"
        },
        "unit_of_analysis": {
          "$ref": "#/$defs/UnitOfAnalysis"
        },
        "exposure": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/FindingTerm"
            }
          ],
          "description": "干预/暴露/指标检查/分层因素"
        },
        "comparator": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/FindingTerm"
            }
          ]
        },
        "outcome_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Ref"
            }
          ],
          "description": "结局或诊断目标；描述性频率可指向被计数的事件"
        },
        "reference_standard": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/ConceptRef"
            }
          ],
          "description": "仅诊断准确性"
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "crude",
                "adjusted",
                "not_stated",
                "not_applicable"
              ]
            },
            "adjusted_for_span_ids": {
              "$ref": "#/$defs/SpanIdList"
            }
          }
        },
        "hypothesis": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "superiority",
                    "non_inferiority",
                    "equivalence"
                  ]
                },
                "margin": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/$defs/Quantity"
                    }
                  ]
                }
              }
            }
          ]
        },
        "pooled": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "k_studies": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "n_participants": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "model": {
                  "enum": [
                    "fixed",
                    "random",
                    "not_stated",
                    null
                  ]
                }
              }
            }
          ]
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Result"
          }
        },
        "source_span_ids": {
          "allOf": [
            {
              "$ref": "#/$defs/SpanIdList"
            },
            {
              "minItems": 1
            }
          ]
        },
        "parent_finding_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Ref"
            }
          ],
          "description": "亚组结果指向同一比较的总体结果（若文中报告了总体结果）"
        }
      }
    },
    "FindingTerm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "concept": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/ConceptRef"
            }
          ]
        },
        "arm_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Ref"
            }
          ]
        },
        "level": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Quantity"
            }
          ],
          "description": "暴露水平、阈值或分层切点，如 ≥10 mm、≥30 次/月"
        },
        "level_as_reported": {
          "$ref": "#/$defs/NullableString"
        },
        "definition_variant_id": {
          "$ref": "#/$defs/NullableString",
          "description": "复合暴露/分层（如高危腺瘤）的定义变体，从字典选择；无对应填 unmatched"
        }
      }
    },
    "MetaAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "has_search_strategy",
        "included_studies"
      ],
      "properties": {
        "has_search_strategy": {
          "type": "boolean"
        },
        "databases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "search_date_as_reported": {
          "$ref": "#/$defs/NullableString"
        },
        "n_studies": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "n_participants": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "included_studies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string",
                "description": "第一作者+年份或试验名"
              },
              "year": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "registration_id": {
                "$ref": "#/$defs/NullableString"
              },
              "doi_or_pmid": {
                "$ref": "#/$defs/NullableString"
              }
            }
          }
        },
        "span_ids": {
          "$ref": "#/$defs/SpanIdList"
        }
      }
    },
    "Recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rec_ref",
        "number_as_reported",
        "text_span_ids",
        "direction_wording_as_reported",
        "strength_as_reported",
        "certainty_as_reported",
        "conditions",
        "actions"
      ],
      "properties": {
        "rec_ref": {
          "$ref": "#/$defs/Ref"
        },
        "number_as_reported": {
          "$ref": "#/$defs/NullableString"
        },
        "text_span_ids": {
          "allOf": [
            {
              "$ref": "#/$defs/SpanIdList"
            },
            {
              "minItems": 1
            }
          ]
        },
        "direction_wording_as_reported": {
          "type": "string",
          "description": "原文措辞，如 We recommend / 建议 / 不推荐"
        },
        "strength_as_reported": {
          "$ref": "#/$defs/NullableString"
        },
        "certainty_as_reported": {
          "$ref": "#/$defs/NullableString"
        },
        "population_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Ref"
            }
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Condition"
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action_type",
              "text_as_reported"
            ],
            "properties": {
              "action_type": {
                "enum": [
                  "surveillance_exam",
                  "resection_technique",
                  "biopsy",
                  "referral",
                  "drug_start",
                  "drug_stop_or_hold",
                  "drug_avoid",
                  "test",
                  "quality_target",
                  "no_further_surveillance",
                  "training",
                  "other"
                ]
              },
              "target": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/ConceptRef"
                  }
                ]
              },
              "interval": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/Quantity"
                  }
                ]
              },
              "anchor": {
                "enum": [
                  "index_colonoscopy",
                  "resection",
                  "previous_surveillance",
                  "diagnosis",
                  "other",
                  null
                ]
              },
              "phase_no": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "description": "分阶段计划的顺序"
              },
              "text_as_reported": {
                "type": "string"
              }
            }
          }
        },
        "exception_span_ids": {
          "$ref": "#/$defs/SpanIdList"
        },
        "definition_span_ids": {
          "$ref": "#/$defs/SpanIdList"
        },
        "cited_reference_labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "TermDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term",
        "span_ids"
      ],
      "properties": {
        "term": {
          "$ref": "#/$defs/ConceptRef"
        },
        "definition_variant_id": {
          "$ref": "#/$defs/NullableString"
        },
        "span_ids": {
          "allOf": [
            {
              "$ref": "#/$defs/SpanIdList"
            },
            {
              "minItems": 1
            }
          ]
        }
      }
    },
    "Assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "predicate",
        "object",
        "context",
        "statement_role",
        "span_ids"
      ],
      "properties": {
        "subject": {
          "$ref": "#/$defs/ConceptRef"
        },
        "predicate": {
          "enum": [
            "associated_with",
            "increases",
            "decreases",
            "no_significant_difference",
            "expressed_in",
            "regulates",
            "causes_in_model",
            "located_in",
            "subtype_of",
            "used_for",
            "has_symptom",
            "other"
          ]
        },
        "object": {
          "$ref": "#/$defs/ConceptRef"
        },
        "context": {
          "enum": [
            "human",
            "animal",
            "cell_line",
            "in_silico",
            "mixed",
            "not_reported"
          ]
        },
        "statement_role": {
          "enum": [
            "own_result",
            "cited_result",
            "author_conclusion",
            "other"
          ]
        },
        "span_ids": {
          "allOf": [
            {
              "$ref": "#/$defs/SpanIdList"
            },
            {
              "minItems": 1
            }
          ]
        }
      }
    },
    "GuidelineInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuing_body",
        "region",
        "version_label_as_reported",
        "publication_date_as_reported",
        "supersedes_as_reported",
        "span_ids"
      ],
      "properties": {
        "issuing_body": {
          "$ref": "#/$defs/NullableString",
          "description": "制定机构原文名称"
        },
        "region": {
          "$ref": "#/$defs/NullableString",
          "description": "适用国家/地区，原文写明才填"
        },
        "version_label_as_reported": {
          "$ref": "#/$defs/NullableString",
          "description": "版本原文，如“2024版”“2020 update”"
        },
        "publication_date_as_reported": {
          "$ref": "#/$defs/NullableString",
          "description": "发布日期原文，如“2024-08-06”“2020年3月”"
        },
        "supersedes_as_reported": {
          "$ref": "#/$defs/NullableString",
          "description": "原文写明被本指南替代/更新的旧版本"
        },
        "span_ids": {
          "$ref": "#/$defs/SpanIdList"
        }
      }
    }
  }
}